{
  "policyVersion": "1.1.0",
  "registries": {
    "allowedHosts": [
      "registry.npmjs.org"
    ]
  },
  "vulnerabilities": {
    "blockSeverity": [
      "CRITICAL"
    ],
    "blockCvssAtOrAbove": 9.0,
    "reviewSeverity": [
      "HIGH"
    ],
    "reviewCvssAtOrAbove": 7.0
  },
  "licenses": {
    "allowed": [
      "0BSD",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC",
      "MIT",
      "MIT-0",
      "Unlicense"
    ]
  },
  "lifecycleEvents": [
    "preinstall",
    "install",
    "postinstall",
    "prepare"
  ],
  "maintenance": {
    "maxReleaseAgeDays": 730,
    "scope": "direct-npm-dependencies"
  },
  "dependencyIntegrity": {
    "invalidSignatureDecision": "bloquear",
    "missingSignatureDecision": "revision_manual",
    "verificationFailureDecision": "revision_manual",
    "artifactMismatchDecision": "bloquear",
    "weakDigestDecision": "revision_manual"
  },
  "sigstore": {
    "certificateOidcIssuer": "https://token.actions.githubusercontent.com",
    "trustedIdentityRegexes": [],
    "requireBundleForArtifacts": true,
    "requireBundleForPublishedDependencies": false
  },
  "nonNpmIntegrity": {
    "rubyGemsAllowedHosts": [
      "rubygems.org"
    ],
    "mavenAllowedHosts": [
      "repo.maven.apache.org"
    ],
    "mavenRepository": "https://repo.maven.apache.org/maven2"
  },
  "externalSourceFailureDecision": "revision_manual"
}
